{
  "name": "react-native-facesdk",
  "version": "0.1.0",
  "description": "FaceSDK wrapper",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-facesdk-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-facesdk-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luxand/facesdk-react-native.git"
  },
  "author": "Luxand <info@luxand.com> (https://www.luxand.com/facesdk/)",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Luxand/facesdk-react-native/issues"
  },
  "homepage": "https://github.com/Luxand/facesdk-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "nitrogen": "^0.36.5",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-worklets": "5.2.2",
    "react-native-worklets": "^0.11.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-vision-camera": "*",
    "react-native-vision-camera-worklets": "*",
    "react-native-worklets": "*"
  },
  "resolutions": {
    "react-native-nitro-image": "0.15.1",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-worklets": "5.2.2"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [],
    "version": "0.63.0"
  },
  "dependencies": {
    "base64-arraybuffer": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "react-native-vision-camera": {
      "optional": true
    },
    "react-native-vision-camera-worklets": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
